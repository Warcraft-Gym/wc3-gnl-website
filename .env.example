# ---------------------------------------------------------------------------
# Warcraft 3 Gym — web
# Copy to `.env.local` and fill in. The site runs fully on fixtures with none
# of these set, so local dev works out of the box.
# ---------------------------------------------------------------------------

# --- FastAPI backend (league data: standings, schedule, teams, players) ---
# Base URL of the GNL backend API (docs at <base>/docs). Leave empty to use
# fixtures. Production: https://wc3-gym-backend-snowy.vercel.app
GNL_API_BASE_URL=
# Read-scoped JWT used server-side only. Never exposed to the browser.
GNL_SERVICE_TOKEN=

# --- Sanity (blog / editorial content) ---
# Leave empty to use fixture posts. Set to enable the live blog + Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
# Editor-scoped token (sanity.io/manage → API → Tokens). Server-only; lets the
# public "Submit a build" form create draft build orders for review.
SANITY_API_WRITE_TOKEN=
# Secret shared with the Sanity webhook that hits /api/revalidate on publish,
# so new builds / posts appear immediately instead of after the ISR window.
SANITY_REVALIDATE_SECRET=

# Public origin used for canonical URLs, the sitemap, robots.txt and share
# images. Leave unset on Vercel (the project's production URL is used) and set
# it once the custom domain is live, e.g. https://warcraft-gym.com
NEXT_PUBLIC_SITE_URL=
